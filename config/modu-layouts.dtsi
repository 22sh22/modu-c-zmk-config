 *
 * Studio layout derived from config/info.json, in default_transform order.
 * Keep all 67 logical positions, including placeholders 51..56.
 * Use alt_thumb_kscan so the existing P0.08 orientation remapping is preserved.
 */

#include <physical_layouts.dtsi>

/ {
    chosen {
        /delete-property/ zmk,matrix-transform;
        zmk,physical-layout = &modu_layout;
    };

    modu_layout: modu_layout {
        compatible = "zmk,physical-layout";
        display-name = "MODU-C";
        transform = <&default_transform>;
        kscan = <&alt_thumb_kscan>;

        // Dimensions/coordinates are in 1/100 key units.
        //                     w   h    x    y   rot  rx  ry
        keys
            = <&key_physical_attrs 100 100    0    0     0   0   0> // 0: R0C0
            , <&key_physical_attrs 100 100  100    0     0   0   0> // 1: R0C1
            , <&key_physical_attrs 100 100  200    0     0   0   0> // 2: R0C2
            , <&key_physical_attrs 100 100  300    0     0   0   0> // 3: R0C3
            , <&key_physical_attrs 100 100  400    0     0   0   0> // 4: R0C4
            , <&key_physical_attrs 100 100  500    0     0   0   0> // 5: R0C5
            , <&key_physical_attrs 100 100  800    0     0   0   0> // 6: R0C6
            , <&key_physical_attrs 100 100  900    0     0   0   0> // 7: R0C7
            , <&key_physical_attrs 100 100 1000    0     0   0   0> // 8: R0C8
            , <&key_physical_attrs 100 100 1100    0     0   0   0> // 9: R0C9
            , <&key_physical_attrs 100 100 1200    0     0   0   0> // 10: R0C10
            , <&key_physical_attrs 100 100 1300    0     0   0   0> // 11: R0C11
            , <&key_physical_attrs 100 100    0  100     0   0   0> // 12: R1C0
            , <&key_physical_attrs 100 100  100  100     0   0   0> // 13: R1C1
            , <&key_physical_attrs 100 100  200  100     0   0   0> // 14: R1C2
            , <&key_physical_attrs 100 100  300  100     0   0   0> // 15: R1C3
            , <&key_physical_attrs 100 100  400  100     0   0   0> // 16: R1C4
            , <&key_physical_attrs 100 100  500  100     0   0   0> // 17: R1C5
            , <&key_physical_attrs 100 100  800  100     0   0   0> // 18: R1C6
            , <&key_physical_attrs 100 100  900  100     0   0   0> // 19: R1C7
            , <&key_physical_attrs 100 100 1000  100     0   0   0> // 20: R1C8
            , <&key_physical_attrs 100 100 1100  100     0   0   0> // 21: R1C9
            , <&key_physical_attrs 100 100 1200  100     0   0   0> // 22: R1C10
            , <&key_physical_attrs 100 100 1300  100     0   0   0> // 23: R1C11
            , <&key_physical_attrs 100 100    0  200     0   0   0> // 24: R2C0
            , <&key_physical_attrs 100 100  100  200     0   0   0> // 25: R2C1
            , <&key_physical_attrs 100 100  200  200     0   0   0> // 26: R2C2
            , <&key_physical_attrs 100 100  300  200     0   0   0> // 27: R2C3
            , <&key_physical_attrs 100 100  400  200     0   0   0> // 28: R2C4
            , <&key_physical_attrs 100 100  500  200     0   0   0> // 29: R2C5
            , <&key_physical_attrs 100 100  800  200     0   0   0> // 30: R2C6
            , <&key_physical_attrs 100 100  900  200     0   0   0> // 31: R2C7
            , <&key_physical_attrs 100 100 1000  200     0   0   0> // 32: R2C8
            , <&key_physical_attrs 100 100 1100  200     0   0   0> // 33: R2C9
            , <&key_physical_attrs 100 100 1200  200     0   0   0> // 34: R2C10
            , <&key_physical_attrs 100 100 1300  200     0   0   0> // 35: R2C11
            , <&key_physical_attrs 100 100    0  300     0   0   0> // 36: R3C0
            , <&key_physical_attrs 100 100  100  300     0   0   0> // 37: R3C1
            , <&key_physical_attrs 100 100  200  300     0   0   0> // 38: R3C2
            , <&key_physical_attrs 100 100  300  300     0   0   0> // 39: R3C3
            , <&key_physical_attrs 100 100  400  300     0   0   0> // 40: R3C4
            , <&key_physical_attrs 100 100  500  300     0   0   0> // 41: R3C5
            , <&key_physical_attrs 100 100  800  300     0   0   0> // 42: R3C6
            , <&key_physical_attrs 100 100  900  300     0   0   0> // 43: R3C7
            , <&key_physical_attrs 100 100 1000  300     0   0   0> // 44: R3C8
            , <&key_physical_attrs 100 100 1100  300     0   0   0> // 45: R3C9
            , <&key_physical_attrs 100 100 1200  300     0   0   0> // 46: R3C10
            , <&key_physical_attrs 100 100 1300  300     0   0   0> // 47: R3C11
            , <&key_physical_attrs 100 100    0  400     0   0   0> // 48: R4C0
            , <&key_physical_attrs 100 100  100  400     0   0   0> // 49: R4C1
            , <&key_physical_attrs 100 100  200  400     0   0   0> // 50: R4C2
            , <&key_physical_attrs  22  22  560  438     0   0   0> // 51: R4C3 (placeholder)
            , <&key_physical_attrs  22  22  598  438     0   0   0> // 52: R4C4 (placeholder)
            , <&key_physical_attrs  22  22  636  438     0   0   0> // 53: R4C5 (placeholder)
            , <&key_physical_attrs  22  22  674  438     0   0   0> // 54: R4C6 (placeholder)
            , <&key_physical_attrs  22  22  712  438     0   0   0> // 55: R4C7 (placeholder)
            , <&key_physical_attrs  22  22  750  438     0   0   0> // 56: R4C8 (placeholder)
            , <&key_physical_attrs 100 100 1100  400     0   0   0> // 57: R4C9
            , <&key_physical_attrs 100 100 1200  400     0   0   0> // 58: R4C10
            , <&key_physical_attrs 100 100 1300  400     0   0   0> // 59: R4C11
            , <&key_physical_attrs 100 100  300  525     0   0   0> // 60: R5C0
            , <&key_physical_attrs 100 100  400  525     0   0   0> // 61: R5C1
            , <&key_physical_attrs 100 100  500  525     0   0   0> // 62: R5C2
            , <&key_physical_attrs 100 100  800  525     0   0   0> // 63: R5C6
            , <&key_physical_attrs 100 100  900  525     0   0   0> // 64: R5C7
            , <&key_physical_attrs 100 100 1000  525     0   0   0> // 65: R5C8
            , <&key_physical_attrs 100 100 1100  525     0   0   0> // 66: R5C9
            ;
    };
};
