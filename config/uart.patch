+/*
+ * Copyright (c) 2026 EKS Inc.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Control messages use the existing wired envelope and CRC, not another
+ * UART protocol. One outstanding request proves BOTH directions still work.
+ * A duplicate request may be answered, but must not extend the lease.
+ */
+#define ZMK_WIRED_LINK_VERSION 1
+#define ZMK_WIRED_LINK_INTERVAL_MS 100
+#define ZMK_WIRED_LINK_TIMEOUT_MS 600
+
+enum zmk_wired_link_phase {
+    ZMK_WIRED_LINK_PROBE = 1,
+    ZMK_WIRED_LINK_COMMIT,
+    ZMK_WIRED_LINK_PING,
+};
+
+struct zmk_wired_link {
+    uint32_t session;
+    uint32_t peer;
+    uint32_t sequence;
+    uint8_t phase;
+    bool ready;
+    bool pending;
+    int64_t last_rx;
+};
+
+static inline void zmk_wired_link_reset(struct zmk_wired_link *link, uint32_t session,
+                                        uint32_t peer, int64_t now) {
+    *link = (struct zmk_wired_link){
+        .session = session, .peer = peer, .phase = ZMK_WIRED_LINK_PROBE, .last_rx = now};
+}
+
+static inline bool zmk_wired_link_expired(const struct zmk_wired_link *link, int64_t now) {
+    return now - link->last_rx >= ZMK_WIRED_LINK_TIMEOUT_MS;
+}
+
+static inline void zmk_wired_link_request(struct zmk_wired_link *link) {
+    if (!link->pending) {
+        ++link->sequence;
+        link->pending = true;
+    }
+}
+
+/* Central accepts only the response to its outstanding challenge. */
+static inline bool zmk_wired_link_response(struct zmk_wired_link *link, uint8_t version,
+                                           uint8_t phase, uint32_t session, uint32_t peer,
+                                           uint32_t sequence, int64_t now) {
+    if (zmk_wired_link_expired(link, now) || version != ZMK_WIRED_LINK_VERSION || !link->pending ||
+        session != link->session || !peer || phase != link->phase || sequence != link->sequence ||
+        (phase != ZMK_WIRED_LINK_PROBE && peer != link->peer)) {
+        return false;
+    }
+    link->last_rx = now;
+    link->pending = false;
+    link->peer = peer;
+    if (phase == ZMK_WIRED_LINK_PROBE) {
+        link->phase = ZMK_WIRED_LINK_COMMIT;
+    } else {
+        link->phase = ZMK_WIRED_LINK_PING;
+        link->ready = true;
+    }
+    return true;
+}
+
+/* Peripheral accepts a new central session only through PROBE, and switches
+ * only after a COMMIT echoing its own fresh cookie. */
+static inline bool zmk_wired_link_receive(struct zmk_wired_link *link, uint8_t version,
+                                          uint8_t phase, uint32_t session, uint32_t peer,
+                                          uint32_t sequence, uint32_t fresh_cookie, int64_t now) {
+    if (version != ZMK_WIRED_LINK_VERSION || !session || phase < ZMK_WIRED_LINK_PROBE ||
+        phase > ZMK_WIRED_LINK_PING) {
+        return false;
+    }
+    if (phase == ZMK_WIRED_LINK_PROBE) {
+        if (peer != 0) {
+            return false;
+        }
+        if (session != link->session) {
+            zmk_wired_link_reset(link, session, fresh_cookie, now);
+            link->sequence = sequence;
+            return true;
+        }
+        return link->phase == phase && link->sequence == sequence;
+    }
+    if (session != link->session || !peer || peer != link->peer) {
+        return false;
+    }
+    if (sequence == link->sequence) {
+        return phase == link->phase;
+    }
+    if (sequence != link->sequence + 1 ||
+        (phase == ZMK_WIRED_LINK_COMMIT && link->phase != ZMK_WIRED_LINK_PROBE) ||
+        (phase == ZMK_WIRED_LINK_PING && !link->ready)) {
+        return false;
+    }
+    link->sequence = sequence;
+    link->phase = phase;
+    link->last_rx = now;
+    link->ready = true;
+    return true;
+}
